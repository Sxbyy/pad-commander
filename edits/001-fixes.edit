### EDIT PadCommander/Sources/Model/Zip.swift
--- OLD
                let filter: OutputFilter? = e.method == 8 ? try OutputFilter(.decompress, using: .zlib) { (d: Data?) in
                    if let d { try sink(d) }
                } : nil
--- NEW
                var filter: OutputFilter?
